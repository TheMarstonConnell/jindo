# ─────────────────────────────────────────────────────────────────
# Network — pick one
# ─────────────────────────────────────────────────────────────────

# Base Sepolia (testnet, chainId 84532) — start here
JINDO_RPC_URL=https://sepolia.base.org

# Base Mainnet (chainId 8453) — uncomment once you've verified everything on Sepolia
# JINDO_RPC_URL=https://mainnet.base.org

# A public RPC works for low-volume use; for serious traffic, use Alchemy / QuickNode / Tenderly:
# JINDO_RPC_URL=https://base-sepolia.g.alchemy.com/v2/<your-key>

# ─────────────────────────────────────────────────────────────────
# Identity
# ─────────────────────────────────────────────────────────────────

# Used by `jindo start` (host) and `jindo prove` to sign on-chain txs,
# AND by `jindo upload/delete/list/recover` (client) to sign EIP-712 intents.
# Keep host and client keys in SEPARATE .env files / shells — they must be different keys.
JINDO_PRIVATE_KEY=0x<32-byte hex key, no quotes>

# ─────────────────────────────────────────────────────────────────
# Contract — fill in AFTER deploying
# ─────────────────────────────────────────────────────────────────

JINDO_CONTRACT=0x<deployed Jindo contract address>

# ─────────────────────────────────────────────────────────────────
# USDC — passed to the Jindo constructor at deploy time. The deploy
# scripts default this to the right address for the network you're
# deploying to, so you usually don't need to set it here. Override it
# only if you're deploying against a custom / mock token (e.g. for
# local testing).
# ─────────────────────────────────────────────────────────────────

# Base Sepolia (Circle's testnet USDC)
# JINDO_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Base Mainnet (bridged USDC)
# JINDO_USDC=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913

# ─────────────────────────────────────────────────────────────────
# Host config (only used by `jindo start`)
# ─────────────────────────────────────────────────────────────────

JINDO_PORT=5689
JINDO_DATA_DIR=./data

# ─────────────────────────────────────────────────────────────────
# Client config (only used by `jindo upload / delete / list / recover`)
# ─────────────────────────────────────────────────────────────────

JINDO_CACHE_DIR=${HOME}/.jindo/cache

# ─────────────────────────────────────────────────────────────────
# S3 gateway config (only used by `jindo s3`)
# Inherits JINDO_PRIVATE_KEY / JINDO_RPC_URL / JINDO_CONTRACT from above —
# the gateway holds one on-chain identity and stores all uploaded objects
# under it. AWS SDK callers authenticate with credentials from the
# gateway's sqlite (a default key is seeded on first start and printed
# to the log).
# ─────────────────────────────────────────────────────────────────

JINDO_S3_PORT=5690
JINDO_S3_DATA_DIR=./data/s3
JINDO_S3_CACHE_DIR=${HOME}/.jindo/s3-cache

# URL of the jindo storage host this gateway forwards uploads to.
JINDO_HOST_URL=http://127.0.0.1:5689

# ─────────────────────────────────────────────────────────────────
# Deployment-only (used by `bun run deploy`; not needed by host or client)
# ─────────────────────────────────────────────────────────────────

# Can be the same key as JINDO_PRIVATE_KEY if the deployer is also the host.
DEPLOYER_PRIVATE_KEY=0x<32-byte hex key, no quotes>

# Optional: enables Basescan verification at deploy time
BASESCAN_API_KEY=<https://basescan.org/myapikey>
